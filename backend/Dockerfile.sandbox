# Sandbox image: one throwaway container per job, runs graph/run_job.py.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ffmpeg \
    dvisvgm \
    texlive \
    texlive-latex-extra \
    texlive-fonts-extra \
    texlive-latex-recommended \
    texlive-science \
    texlive-fonts-recommended \
    tipa \
    libcairo2-dev \
    libpango1.0-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
# CPU-only build: this container has no GPU.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install --no-cache-dir -r requirements.txt

RUN python -m spacy download en_core_web_sm
RUN python -c "from kokoro import KPipeline; KPipeline(lang_code='a')"

COPY config/ config/
COPY nodes/ nodes/
COPY graph/ graph/

ENV PYTHONPATH=/app
ENTRYPOINT ["python", "-m", "graph.run_job"]
